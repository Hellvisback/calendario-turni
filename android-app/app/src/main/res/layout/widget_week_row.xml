<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:paddingStart="6dp"
    android:paddingTop="5dp"
    android:paddingEnd="6dp"
    android:paddingBottom="5dp">

    <!-- 7 Giorni della settimana che occupano la larghezza in modo equilibrato -->
    <LinearLayout
        android:id="@+id/wr_days_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingEnd="26dp">

        <!-- Day 0 (Lunedì) -->
        <LinearLayout
            android:id="@+id/cell_wr_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/wr_day_name_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_day_num_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="#F1F5F9"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_shift_code_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="MAT"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 1 (Martedì) -->
        <LinearLayout
            android:id="@+id/cell_wr_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/wr_day_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_day_num_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13"
                android:textColor="#F1F5F9"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_shift_code_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="MAT"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 2 (Mercoledì) -->
        <LinearLayout
            android:id="@+id/cell_wr_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/wr_day_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_day_num_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14"
                android:textColor="#F1F5F9"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_shift_code_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="POM"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 3 (Giovedì) -->
        <LinearLayout
            android:id="@+id/cell_wr_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/wr_day_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_day_num_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="#F1F5F9"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_shift_code_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="POM"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 4 (Venerdì) -->
        <LinearLayout
            android:id="@+id/cell_wr_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/wr_day_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="V"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_day_num_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16"
                android:textColor="#F1F5F9"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_shift_code_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="NOT"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 5 (Sabato) -->
        <LinearLayout
            android:id="@+id/cell_wr_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/wr_day_name_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_day_num_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17"
                android:textColor="#F1F5F9"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_shift_code_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="SMO"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Day 6 (Domenica) -->
        <LinearLayout
            android:id="@+id/cell_wr_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/wr_day_name_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_day_num_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18"
                android:textColor="#FCA5A5"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wr_shift_code_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="RIP"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Navigation arrows in basso a destra (perfettamente centrate) -->
    <LinearLayout
        android:id="@+id/wr_nav_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="1dp">

        <ImageView
            android:id="@+id/btn_wr_prev"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_widget_nav_btn"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_chevron_left"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_wr_next"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_widget_nav_btn"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_chevron_right" />
    </LinearLayout>

</RelativeLayout>
