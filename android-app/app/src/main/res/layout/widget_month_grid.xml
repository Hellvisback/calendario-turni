<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_widget_turnisync_dark" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_previous" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="26sp" android:textColor="#BCB8FF" android:contentDescription="Periodo precedente" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="TurniSync" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end" android:textColor="#F4F3F7" />
        <TextView android:id="@+id/widget_next" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="26sp" android:textColor="#BCB8FF" android:contentDescription="Periodo successivo" />
    </LinearLayout>
    <TextView android:id="@+id/widget_profile" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center_vertical" android:paddingStart="6dp" android:text="Il tuo calendario" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:textColor="#BEC1CD" />
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
</LinearLayout>
