<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:paddingStart="7dp"
    android:paddingTop="6dp"
    android:paddingEnd="7dp"
    android:paddingBottom="5dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_wp_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:text="Ottobre 2026"
            android:textColor="#38BDF8"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/widget_wp_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_card"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="2 Settimane"
            android:textColor="#94A3B8"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Week 1 (7 Days) -->
    <LinearLayout
        android:id="@+id/wp_week1_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Day 0 -->
