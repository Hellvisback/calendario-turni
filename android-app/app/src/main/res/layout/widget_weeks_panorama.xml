            <TextView android:id="@+id/wp_day_num_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:includeFontPadding="false" android:text="13" android:textColor="#F1F5F9" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/wp_shift_badge_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@drawable/bg_widget_badge" android:includeFontPadding="false" android:paddingStart="4.5dp" android:paddingTop="1.5dp" android:paddingEnd="4.5dp" android:paddingBottom="1.5dp" android:text="MAT" android:textColor="#FFFFFF" android:textSize="9.5sp" android:textStyle="bold" />
