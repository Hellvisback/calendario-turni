    <!-- Navigation row in bottom right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <ImageView
            android:id="@+id/btn_wp_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_widget_nav_btn"
            android:padding="5.5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_chevron_left"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wp_week_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="5dp"
            android:text="+1 sett."
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_wp_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_widget_nav_btn"
            android:padding="5.5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_chevron_right" />
    </LinearLayout>

</LinearLayout>
