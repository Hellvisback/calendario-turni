        </LinearLayout>

        <!-- Day 6 -->
        <LinearLayout android:id="@+id/wp_col_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:gravity="center" android:orientation="vertical" android:paddingStart="1dp" android:paddingTop="3dp" android:paddingEnd="1dp" android:paddingBottom="3dp">
