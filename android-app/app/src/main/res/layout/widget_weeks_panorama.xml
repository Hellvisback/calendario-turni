            <TextView android:id="@+id/wp_day_name_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="V" android:textColor="#64748B" android:textSize="10.5sp" android:textStyle="bold" />
