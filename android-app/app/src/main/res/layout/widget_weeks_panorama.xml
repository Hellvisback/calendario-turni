        <LinearLayout android:id="@+id/wp_col_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1.5dp" android:gravity="center" android:orientation="vertical" android:paddingStart="1dp" android:paddingTop="3dp" android:paddingEnd="1dp" android:paddingBottom="3dp">
            <TextView android:id="@+id/wp_day_name_10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="G" android:textColor="#64748B" android:textSize="10.5sp" android:textStyle="bold" />
