<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: Data Odierna & Badge OGGI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_tt_header_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:text="Gio 15 Ottobre"
            android:textColor="#38BDF8"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Main Card: Turno di Oggi -->
    <LinearLayout
        android:id="@+id/widget_tt_today_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_card"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tt_code_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="7dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2.5dp"
                android:text="POM"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tt_shift_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:singleLine="true"
                android:maxLines="1"
                android:text="Pomeriggio"
                android:textColor="#F8FAFC"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tt_shift_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="14:00 - 21:36"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Indicators Row: Straordinario, Reperibilità, Trasferta -->
        <LinearLayout
            android:id="@+id/widget_tt_extra_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tt_overtime_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_amber"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="+2h Straordinario"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_tt_oncall_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_purple"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="🔔 Reperibile"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_tt_trasferta_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_cyan"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="✈ Trasferta"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Notes text if present -->
        <TextView
            android:id="@+id/widget_tt_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="#CBD5E1"
            android:textSize="10.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Row: Domani Preview Card + Navigation Button outside -->
    <LinearLayout
        android:id="@+id/widget_tt_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_tt_tomorrow_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_tt_tomorrow_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Dom."
                android:textColor="#64748B"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_tt_tomorrow_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge_green"
                android:paddingStart="5dp"
                android:paddingTop="1.5dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1.5dp"
                android:singleLine="true"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:text="NOT"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tt_tomorrow_shift"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:maxLines="1"
                android:text="22:00 - 05:36"
                android:textColor="#E2E8F0"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Navigation arrows in bottom right: completely outside the card! -->
        <ImageView
            android:id="@+id/btn_tt_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_widget_nav_btn"
            android:padding="5.5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_chevron_left"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_tt_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_widget_nav_btn"
            android:padding="5.5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_chevron_right" />
    </LinearLayout>

</LinearLayout>
